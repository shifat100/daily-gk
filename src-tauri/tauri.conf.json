{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../clients/compiled/html5",
    "distDir": "../clients/compiled/html5"
  },
  "package": {
    "productName": "Daily GK",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "Shifat100",
      "identifier": "com.shifat100.dailygk",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Daily GK",
        "width": 1200,
        "height": 800,
        "minWidth": 750,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
